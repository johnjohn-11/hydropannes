{
    "name": "Hydropannes Dev",
    "image": "ghcr.io/ludeeus/container:integration",
    "appPort": [
        "9123:8123"
    ],
    "postCreateCommand": "container install",
    "forwardPorts": [9123],
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspaces/integration,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "github.vscode-pull-request-github"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "editor.defaultFormatter": "charliermarsh.ruff",
                "editor.formatOnSave": true,
                "ruff.organizeImports": true
            }
        }
    }
}
